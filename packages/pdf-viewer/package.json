{
  "name": "@cannyminds/pdf-viewer",
  "version": "0.5.0",
  "description": "A React Headless PDF viewer component built with @embedpdf",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "type": "module",
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "react",
    "pdf",
    "viewer",
    "embedpdf",
    "component"
  ],
  "author": "CannyMinds Dev Team",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "demo.png"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CannyMinds/PDF-Viewer-Lib.git",
    "directory": "packages/pdf-viewer"
  },
  "packageManager": "pnpm@10.10.0",
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "dependencies": {
    "@embedpdf/core": "2.2.0",
    "@embedpdf/engines": "2.2.0",
    "@embedpdf/models": "2.2.0",
    "@embedpdf/plugin-annotation": "2.2.0",
    "@embedpdf/plugin-export": "2.2.0",
    "@embedpdf/plugin-history": "2.2.0",
    "@embedpdf/plugin-interaction-manager": "2.2.0",
    "@embedpdf/plugin-document-manager": "2.2.0",
    "@embedpdf/plugin-print": "2.2.0",
    "@embedpdf/plugin-render": "2.2.0",
    "@embedpdf/plugin-rotate": "2.2.0",
    "@embedpdf/plugin-scroll": "2.2.0",
    "@embedpdf/plugin-search": "2.2.0",
    "@embedpdf/plugin-selection": "2.2.0",
    "@embedpdf/plugin-viewport": "2.2.0",
    "@embedpdf/plugin-zoom": "2.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}